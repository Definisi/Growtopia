{
  "api_examples": {
    "base_url": "http://localhost:8080/api",
    "headers": {
      "Content-Type": "application/json"
    },
    "endpoints": {
      "bot_management": {
        "add_bot": {
          "option": "add",
          "tank_id_name": "your_bot_name",
          "tank_id_pass": "your_password",
          "server": "growtopia1.com",
          "port": 17091
        },
        "remove_bot": {
          "option": "remove",
          "tank_id_name": "your_bot_name"
        },
        "list_clients": {
          "option": "list_clients"
        },
        "disconnect_bot": {
          "option": "disconnect",
          "tank_id_name": "your_bot_name"
        },
        "reconnect_bot": {
          "option": "reconnect",
          "tank_id_name": "your_bot_name"
        }
      },
      "movement": {
        "move": {
          "option": "move",
          "tank_id_name": "your_bot_name",
          "x": 100,
          "y": 200
        },
        "teleport": {
          "option": "teleport",
          "tank_id_name": "your_bot_name",
          "x": 150,
          "y": 250
        },
        "warp": {
          "option": "warp",
          "tank_id_name": "your_bot_name",
          "world": "START"
        }
      },
      "block_interaction": {
        "place_block": {
          "option": "place",
