          "x": 100,
          "y": 200
        },
        "punch_block": {
          "option": "punch",
          "tank_id_name": "your_bot_name",
          "x": 100,
          "y": 200
        },
        "wrench_block": {
          "option": "wrench",
          "tank_id_name": "your_bot_name",
          "x": 100,
          "y": 200
        }
      },
      "item_management": {
        "consume_item": {
          "option": "consume",
          "tank_id_name": "your_bot_name",
          "item_id": 123
        },
        "wear_item": {
          "option": "wear",
          "tank_id_name": "your_bot_name",
          "item_id": 456
        },
        "collect_items": {
          "option": "collect",
          "tank_id_name": "your_bot_name",
          "range": 3,
          "force": false
        },
        "get_inventory": {
          "option": "inventory",
          "tank_id_name": "your_bot_name"
        }
      },
      "communication": {
        "send_message": {
          "option": "send",
          "tank_id_name": "your_bot_name",
