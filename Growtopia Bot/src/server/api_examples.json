        "smoke": {
          "option": "smoke",
          "tank_id_name": "your_bot_name"
        }
      },
      "information": {
        "get_client_info": {
          "option": "client",
          "tank_id_name": "your_bot_name"
        },
        "get_status": {
          "option": "status",
          "tank_id_name": "your_bot_name"
        },
        "get_ping": {
          "option": "ping",
          "tank_id_name": "your_bot_name"
        },
        "get_world_info": {
          "option": "world_info",
          "tank_id_name": "your_bot_name"
        },
        "get_player_info": {
          "option": "player_info",
          "tank_id_name": "your_bot_name"
        }
      },
      "utility": {
        "reset_bot": {
          "option": "reset",
          "tank_id_name": "your_bot_name"
        }
      }
    }
